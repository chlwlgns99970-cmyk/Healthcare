# Inject the real value with the hosting platform's secret manager.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
PORT=8000
FOOD_ANALYSIS_FORWARDED_ALLOW_IPS=127.0.0.1
FOOD_ANALYSIS_REQUEST_TIMEOUT_SECONDS=45
FOOD_ANALYSIS_MAX_IMAGE_BYTES=5242880
FOOD_ANALYSIS_MAX_IMAGE_DIMENSION=1600
FOOD_ANALYSIS_MAX_IMAGE_PIXELS=20000000
FOOD_ANALYSIS_RATE_LIMIT=20/minute
FOOD_ANALYSIS_DAILY_REQUEST_LIMIT=1000
FOOD_ANALYSIS_ENVIRONMENT=development
FOOD_ANALYSIS_IDEMPOTENCY_TTL_SECONDS=600
FOOD_ANALYSIS_PROVIDER_MAX_RETRIES=1
FOOD_ANALYSIS_MAX_OUTPUT_TOKENS=1800
FOOD_ANALYSIS_MAX_ITEMS=12
